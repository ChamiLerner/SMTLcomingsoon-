{
  "collections": {
    "expenses": {
      "fields": {
        "xid":     { "type": "string",  "required": true, "maxLength": 40 },
        "title":   { "type": "string",  "maxLength": 120, "trim": true },
        "cents":   { "type": "integer", "required": true, "minimum": 0, "maximum": 100000000 },
        "cat":     { "type": "string",  "maxLength": 24 },
        "payer":   { "type": "string",  "required": true, "maxLength": 40 },
        "parts":   { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 60 },
        "ts":      { "type": "number" },
        "rev":     { "type": "integer", "default": 0 },
        "deleted": { "type": "boolean", "default": false }
      },
      "access": { "read": "public", "insert": "public", "update": "public", "delete": "public" },
      "publicMutation": "open"
    },
    "members": {
      "fields": {
        "xid":     { "type": "string",  "required": true, "maxLength": 40 },
        "name":    { "type": "string",  "required": true, "maxLength": 60, "trim": true },
        "ts":      { "type": "number" },
        "deleted": { "type": "boolean", "default": false }
      },
      "access": { "read": "public", "insert": "public", "update": "public", "delete": "public" },
      "publicMutation": "open"
    },
    "settle": {
      "fields": {
        "xid":     { "type": "string",  "required": true, "maxLength": 40 },
        "ts":      { "type": "number",  "required": true },
        "deleted": { "type": "boolean", "default": false }
      },
      "access": { "read": "public", "insert": "public", "update": "public", "delete": "public" },
      "publicMutation": "open"
    },
    "scores": {
      "fields": {
        "xid":      { "type": "string",  "required": true, "maxLength": 40 },
        "player":   { "type": "string",  "required": true, "maxLength": 40 },
        "game":     { "type": "string",  "maxLength": 20, "default": "connect" },
        "pdate":    { "type": "string",  "required": true, "maxLength": 20 },
        "solved":   { "type": "boolean", "default": false },
        "mistakes": { "type": "integer", "minimum": 0, "maximum": 100 },
        "points":   { "type": "integer", "minimum": 0, "maximum": 1000 },
        "ts":       { "type": "number" }
      },
      "access": { "read": "public", "insert": "public", "update": "public", "delete": "public" },
      "publicMutation": "open"
    }
  }
}
